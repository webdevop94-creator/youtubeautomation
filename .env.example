# ---- Copy this file to ".env" and fill in your keys ----

# Script writing. Free key: https://console.groq.com  (100,000 tokens/day)
GROQ_API_KEY=gsk_your_key_here

# Fallback script writer, used automatically when Groq's daily quota runs out.
# Free key: https://build.nvidia.com  (key starts with "nvapi-")
# Optional -- leave blank to use Groq only.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v3.1

# Copyright-free visuals. Free key: https://www.pexels.com/api/  (200 req/hour)
PEXELS_API_KEY=your_pexels_key_here

# YouTube upload. https://console.cloud.google.com
#   1. New project -> enable "YouTube Data API v3"
#   2. OAuth consent screen -> External -> add your email as Test user
#   3. Credentials -> Create OAuth client ID -> Desktop app
#   4. Paste Client ID + Secret below, then run: python setup_youtube.py
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret

# ---- Optional tuning ----
GROQ_MODEL=llama-3.3-70b-versatile

# TTS engine: "edge" (Microsoft cloud, default) or "kokoro" (local, offline)
TTS_ENGINE=edge

# --- edge engine ---
# Voice: hi-IN-MadhurNeural (male) | hi-IN-SwaraNeural (female)
#        en-IN-PrabhatNeural (male, Indian English) | en-IN-NeerjaNeural (female)
#        en-IN-NeerjaExpressiveNeural (female, more expressive)
# These four Hindi/Indian-English voices are the complete set edge-tts offers.
VOICE=hi-IN-MadhurNeural
VOICE_RATE=+8%

# --- kokoro engine (only used when TTS_ENGINE=kokoro) ---
# Hindi voices: hm_omega, hm_psi (male) | hf_alpha, hf_beta (female)
KOKORO_VOICE=hm_omega
KOKORO_SPEED=1.0

FPS=30
MUSIC_VOLUME_DB=-22
OUTPUT_DIRECTORY=./output

# Upload privacy for new videos: private | unlisted | public
# Start with "private" until you trust the output, then switch to public.
UPLOAD_PRIVACY=private

# ---- Worldwide viral discovery (viral.py / agent.py) ----

# Countries whose Google Trends lists are read. A story trending in several of
# these at once is what the ranking actually rewards, so breadth beats depth --
# but each country is one more HTTP request per run.
VIRAL_GEOS=US,IN,GB,CA,AU,DE,BR,JP,ZA,NG

# Google News sections pulled alongside the trends lists.
NEWS_SECTIONS=WORLD,BUSINESS,TECHNOLOGY,ENTERTAINMENT,SPORTS,SCIENCE

# Set true only if you will review every script yourself. Leaving it false
# keeps shootings, court cases, war and elections out of an unattended channel
# -- YouTube demonetises violent tragedy and carries strike risk on elections.
ALLOW_SENSITIVE=false

# Restrict the agent to certain topics. Empty = everything.
# Options: tech,science,sports,entertainment,business,health,world,general
ALLOWED_CATEGORIES=

# ---- Autonomous agent ----
VIDEOS_PER_RUN=1
MAX_TOPIC_ATTEMPTS=4

# Days a covered story stays in the duplicate guard. A big story trends for
# most of a week; this stops the agent re-publishing it every morning.
HISTORY_DAYS=45
