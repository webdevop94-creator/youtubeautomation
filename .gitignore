.env
.youtube_token.json
output/
music/
__pycache__/
*.pyc
.venv/
.venv-tts/
venv/
env/
history.json
agent.log

# Throwaway comparison artefacts from tuning voices, visuals and motion.
voice_samples/
compare/
story_test/

# Anything that could carry a credential. The YouTube token grants upload
# access to the channel, so a stray copy is as dangerous as the original.
*.env
.env.*
!.env.example
*token*.json
*credential*.json
*secret*
client_secret*.json
*.pem
*.key

# 3D assets: models aur three.js builds, MBs mein. Code commit hota hai,
# binaries nahi — inhe Mixamo/three.js se dobara laya ja sakta hai.
scene3d/assets/
scene3d/node_modules/
scene3d/*.mp4
scene3d/job.json

# Scratch jobs and preview stills from tuning the scene.
scene3d/job_*.json
scene3d/peek_*.png
scene3d/v_*.png
scene3d/m_*.png
scene3d/s_*.png
scene3d/row_*.png
scene3d/*.mp4
